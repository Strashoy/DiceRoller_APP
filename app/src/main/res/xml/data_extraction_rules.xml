<?xml version="1.0" encoding="utf-8"?><!--
   Qué se copia en la nube y al pasar de un teléfono a otro (Android 12 o superior).
   Todo se respalda salvo el archivo de Discord: guarda la URL del webhook, que es un secreto
   (quien la tenga puede escribir en el canal). En un teléfono nuevo se vuelve a pegar.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/discord.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/discord.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
